# Copy this file to `.env` and adjust it. `.env` is never committed.
#
# This example is for a LOCAL demo database made with `npm run db:setup` and `npm run seed:demo`.
# Both commands refuse any database that is not local and empty.

# A local, empty PostgreSQL database (create it first: `createdb lomir_demo`).
DATABASE_URL=postgresql://localhost:5432/lomir_demo

PORT=5001
NODE_ENV=development

# Any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend (CORS and the links in e-mails).
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ImageKit (avatars and chat files). The server will not start without these three values; the
# placeholders below are enough to run the app, but uploading a picture or a file will fail until
# they are real keys from your own ImageKit account.
IMAGEKIT_PUBLIC_KEY=placeholder
IMAGEKIT_PRIVATE_KEY=placeholder
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/placeholder

# Optional. Without an e-mail key no mail is sent (registration still works, but confirmation links
# are not delivered; the demo accounts are already confirmed).
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# TURNSTILE_SECRET_KEY=
